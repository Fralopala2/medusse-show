<?xml version="1.0" encoding="UTF-8"?><fritzing version="0.9.3">
 <module fritzingVersion="0.9.3" moduleId="ESP32NanoSensorDiagram">
  <version>1.0</version>
  <date>2025-12-06</date>
  <author>Medusse IoT Project</author>
  <description>Diagrama de conexiones Arduino Nano ESP32 con 18 sensores - Proyecto Medusse IoT</description>
  <title>Arduino Nano ESP32 - Medusse IoT Sensor Connections</title>
  
  <views>
   <breadboardView>
    <layers image="breadboard/Arduino_Nano_ESP32_breadboard.svg">
     <layer layerId="breadboardbreadboard"/>
    </layers>
   </breadboardView>
   <schematicView>
    <layers image="schematic/Arduino_Nano_ESP32_schematic.svg">
     <layer layerId="schematic"/>
    </layers>
   </schematicView>
   <pcbView>
    <layers image="pcb/Arduino_Nano_ESP32_pcb.svg">
     <layer layerId="copper0"/>
     <layer layerId="copper1"/>
    </layers>
   </pcbView>
   <iconView>
    <layers image="icon/Arduino_Nano_ESP32_icon.svg">
     <layer layerId="icon"/>
    </layers>
   </iconView>
  </views>
  
  <connectors>
   <!-- Arduino Nano ESP32 Pins -->
   <connector id="connector0" name="3V3" type="male">
    <description>3.3V Power Supply</description>
   </connector>
   <connector id="connector1" name="GND" type="male">
    <description>Ground</description>
   </connector>
   <connector id="connector2" name="D4" type="male">
    <description>GPIO4 - DHT22 Data</description>
   </connector>
   <connector id="connector3" name="D5" type="male">
    <description>GPIO5 - Water Flow Sensor</description>
   </connector>
   <connector id="connector4" name="D6" type="male">
    <description>GPIO6 - Anemometer (Weather Station)</description>
   </connector>
   <connector id="connector5" name="D7" type="male">
    <description>GPIO7 - Pluviometer (Weather Station)</description>
   </connector>
   <connector id="connector6" name="D8" type="male">
    <description>GPIO8 - Wind Vane (Weather Station)</description>
   </connector>
   <connector id="connector7" name="D21" type="male">
    <description>GPIO21 - I2C SDA</description>
   </connector>
   <connector id="connector8" name="D22" type="male">
    <description>GPIO22 - I2C SCL</description>
   </connector>
   <connector id="connector9" name="A0" type="male">
    <description>ADC0 - Gas Sensor</description>
   </connector>
   <connector id="connector10" name="A1" type="male">
    <description>ADC1 - Soil Moisture Capacitive (SEN-0180)</description>
   </connector>
   <connector id="connector11" name="A2" type="male">
    <description>ADC2 - Soil Moisture Anticorrosion (SEN-0083)</description>
   </connector>
   <connector id="connector12" name="A3" type="male">
    <description>ADC3 - pH Sensor Analog Output</description>
   </connector>
   <connector id="connector13" name="A4" type="male">
    <description>ADC4 - TDS Sensor Analog Output</description>
   </connector>
   <connector id="connector14" name="A5" type="male">
    <description>ADC5 - Dissolved Oxygen Sensor</description>
   </connector>
   <connector id="connector15" name="D10" type="male">
    <description>GPIO10 - SPI (Data Logger)</description>
   </connector>
   <connector id="connector16" name="D11" type="male">
    <description>GPIO11 - SPI (Data Logger)</description>
   </connector>
   <connector id="connector17" name="D12" type="male">
    <description>GPIO12 - SPI (Data Logger)</description>
   </connector>
   <connector id="connector18" name="D13" type="male">
    <description>GPIO13 - SPI (Data Logger)</description>
   </connector>
  </connectors>
</module>
</fritzing>