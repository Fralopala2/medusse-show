# Configuracion FTP para deployment
# Copia este archivo a .env.ftp y configura tus credenciales

# Servidor FTP
FTP_HOST=ftp.ejemplo.com
FTP_PORT=21

# Credenciales
FTP_USER=tu_usuario
FTP_PASSWORD=tu_password

# Seguridad (true para FTPS, false para FTP normal)
FTP_SECURE=false

# Directorio remoto base
FTP_REMOTE_DIR=/public_html
